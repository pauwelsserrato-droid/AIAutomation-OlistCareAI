    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'openrouter/free', messages: [ { role: 'system', content: 'Sos un analista senior de soporte para un marketplace similar a Olist. Clasifica el reclamo y redacta un borrador seguro para revision humana. Usa solo los datos provistos. No inventes fechas, movimientos, reembolsos, descuentos ni compensaciones. Responde exclusivamente con JSON valido con estas claves: category, priority, sentiment, summary, draft_reply, needs_human_review y risk_flags. category debe ser demora, seguimiento, cancelacion, reembolso u otro. priority debe ser baja, media, alta o critica. sentiment debe ser positivo, neutral, frustrado o enojado. needs_human_review debe ser true y risk_flags debe ser un array.' }, { role: 'user', content: JSON.stringify({ ticket: { ticket_id: $json.ticket_id, customer_email: $json.customer_email, message: $json.message }, order: { order_id: $json.order_id, order_status: $json.order.order_status, estimated_delivery: $json.order.estimated_delivery, last_tracking_event: $json.order.last_tracking_event, carrier: $json.order.carrier, order_total: $json.order.order_total } }) } ], max_tokens: 650, temperature: 0.2 } }}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "09aa2b46-777e-42fc-8d16-dcd61d0b3ee3",
      "name": "08 Analizar ticket con OpenAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1280,
        288
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "zRBmEbpObVkOojDG",
          "name": "Header Auth account"
        }
