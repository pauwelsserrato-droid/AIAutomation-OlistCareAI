    {
      "parameters": {
        "jsCode": "const context = $('06 Preparar contexto de pedido').first().json;\nconst ai = $('09 Interpretar respuesta IA').first().json;\nconst from = $env.GMAIL_FROM;\nconst subject = `Re: Pedido ${context.order_id} - seguimiento de entrega`;\nconst messageId = context.gmail_message_id;\nconst headers = [\n  `From: ${from}`,\n  `To: ${context.customer_email}`,\n  `Subject: ${subject}`,\n  'Content-Type: text/plain; charset=UTF-8',\n  'MIME-Version: 1.0',\n  'X-Automation-Source: olistcare_ai'\n];\nif (messageId) headers.push(`In-Reply-To: ${messageId}`, `References: ${messageId}`);\nconst mime = `${headers.join('\\r\\n')}\\r\\n\\r\\n${ai.draft_reply}`;\nconst raw = Buffer.from(mime, 'utf8').toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/g, '');\nreturn [{ json: { raw, threadId: context.gmail_thread_id, ticket_record_id: $('13 Evaluar decision humana').first().json.ticket_record_id } }];"
      },
