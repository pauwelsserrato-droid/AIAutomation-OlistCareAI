      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst email = String(body.customer_email ?? '').trim().toLowerCase();\nconst rawOrderId = String(body.order_id ?? '').trim();\nconst orderId = rawOrderId.replace(/[^A-Za-z0-9_-]/g, '');\nconst message = String(body.message ?? '').trim();\nconst automationSource = String(body.automation_source ?? 'customer').trim();\nconst missing = [];\nif (!email || !email.includes('@')) missing.push('customer_email');\nif (!orderId || orderId !== rawOrderId) missing.push('order_id');\nif (message.length < 15) missing.push('message');\nif (automationSource === 'olistcare_ai') missing.push('loop_detected');\nreturn [{ json: {\n  ticket_id: String(body.ticket_id ?? `TKT-${Date.now()}`),\n  customer_email: email,\n  order_id: orderId,\n  message,\n  source: String(body.source ?? 'webhook'),\n  gmail_thread_id: String(body.gmail_thread_id ?? ''),\n  gmail_message_id: String(body.gmail_message_id ?? ''),\n  automation_source: automationSource,\n  received_at: new Date().toISOString(),\n  valid: missing.length === 0,\n  missing_fields: missing\n} }];"
      },
