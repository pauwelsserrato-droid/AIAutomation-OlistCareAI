    {
      "parameters": {
        "jsCode": "const context = $('06 Preparar contexto de pedido').first().json;\nconst message = $json.choices?.[0]?.message ?? {};\nconst content = message.content;\n\nconst fallback = (reason) => ({\n  category: 'otro',\n  priority: 'alta',\n  sentiment: 'neutral',\n  summary: 'La IA no devolvio una respuesta utilizable. El ticket requiere revision humana.',\n  draft_reply: 'No se genero un borrador automatico seguro. Revisar el ticket y los datos del pedido antes de responder al cliente.',\n  needs_human_review: true,\n  risk_flags: [reason]\n});\n\nlet parsed;\nif (!content) {\n  parsed = fallback($json.error ? 'ai_api_error' : 'ai_empty_response');\n} else {\n  const clean = String(content).trim()\n    .replace(/^\\x60\\x60\\x60(?:json)?\\s*/i, '')\n    .replace(/\\s*\\x60\\x60\\x60$/, '')\n    .trim();\n  try {\n    parsed = JSON.parse(clean);\n  } catch {\n    parsed = fallback('ai_invalid_json');\n  }\n}\n\nreturn [{ json: { ...context, ...parsed, ai_provider: 'OpenRouter', openai_response_id: $json.id ?? '' } }];"
      },
