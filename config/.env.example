# Copiar estos nombres a las variables de entorno de n8n.
# Nunca subir valores reales al repositorio.

AIRTABLE_BASE_ID=app_REEMPLAZAR
AIRTABLE_TOKEN=pat_REEMPLAZAR

OPENROUTER_API_KEY=REEMPLAZAR
OPENROUTER_MODEL=REEMPLAZAR_CON_MODELO_GRATUITO

# Token OAuth 2.0 con alcance gmail.send. En produccion conviene usar
# una credencial OAuth2 de n8n y reemplazar el header del nodo Gmail.
GMAIL_ACCESS_TOKEN=REEMPLAZAR
GMAIL_FROM=soporte@tu-dominio.com
APPROVAL_EMAIL=aprobador@tu-dominio.com

# URL publica de produccion de n8n, sin barra final.
N8N_PUBLIC_URL=https://tu-instancia-n8n.example.com
